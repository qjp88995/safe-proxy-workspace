# Copy this file to .env and replace the sample values.

IMAGE_NAME=safe-proxy-workspace:latest
CONTAINER_NAME=safe-proxy-workspace
DOCKERFILE=Dockerfile

# Local runtime config (should stay untracked)
MIHOMO_CONFIG_PATH=./config.yaml

# The TUN device name must match config.yaml/config.example.yaml.
TUN_DEVICE=Mihomo

# 直连白名单现由 config.yaml 的 tun.route-exclude-address 单一维护；
# 修改后无需 recreate，容器内执行 `reload-proxy` 即可热生效。

# Long-lived workspace mount
WORKSPACE_MOUNT=.
# The mapped user's home is persisted in the Docker volume `workspace_home`.
# Controls the in-container username, home directory (/home/<name>), and workspace path (/home/<name>/workspace).
WORKSPACE_USER=workspace

# Docker-out-of-Docker: 取消注释并设为宿主机 docker 组 GID。
# 获取方式: getent group docker | cut -d: -f3
# DOCKER_GID=

# Desktop/VNC mode: switch IMAGE_NAME to the desktop image or DOCKERFILE to Dockerfile.desktop,
# then set DESKTOP_MODE=1 and a VNC password.
DESKTOP_MODE=0
DESKTOP_VNC_BIND=127.0.0.1
DESKTOP_VNC_PORT=5901
VNC_PASSWORD=replace-this-before-use
VNC_GEOMETRY=1440x900
VNC_DEPTH=24
DESKTOP_SHM_SIZE=2gb
